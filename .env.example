# Copy to .env.local and fill in real values.
# AUTH_SECRET can be the same value as NEXTAUTH_SECRET.
#
# Vercel production (Project → Settings → Environment Variables):
# AUTH_URL=https://sultani-arts-web.vercel.app
# NEXTAUTH_URL=https://sultani-arts-web.vercel.app
# AUTH_TRUST_HOST=true
# Do not use localhost URLs on Vercel. Redeploy after saving.

MONGODB_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
# Cloud name is from Cloudinary Dashboard → Settings → Product environment credentials.
# It is not the Media Library folder name (do not use Root).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
